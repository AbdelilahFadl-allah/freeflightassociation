# PostgreSQL connection. Use TLS and a protected secret store in hosted environments.
DATABASE_URL=postgresql://postgres:password@localhost:5432/volubilis
# Supabase project HTTPS origin; must match VITE_SUPABASE_URL.
SUPABASE_URL=
PORT=3000
# Public browser configuration, embedded at build time (never use the service-role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only needed for the one-time admin:bootstrap command; keep secret on the server.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_USER_ID=
# Existing event notifications remain optional and require approved no-variable templates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CALLBACK_BASE_URL=
WHATSAPP_TEMPLATES_JSON=
