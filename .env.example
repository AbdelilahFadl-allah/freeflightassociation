# PostgreSQL connection. Use a protected secret store in production.
DATABASE_URL=postgresql://volubilis:change-me@localhost:5432/volubilis
# Entra directory (tenant) ID and API application/client ID.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# Comma-separated accepted API token audiences, e.g. API client ID and api:// client ID.
ENTRA_API_AUDIENCES=
# Entra object ID of the initial special administrator.
BOOTSTRAP_ADMIN_OBJECT_ID=
PORT=3000
# Frontend SPA application/client ID and delegated API scope.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
# WhatsApp notifications are disabled unless all provider settings are supplied.
# Use an approved Twilio Content Template with no variables for each configured template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CALLBACK_BASE_URL=
WHATSAPP_TEMPLATES_JSON=
